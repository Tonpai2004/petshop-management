{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JsonStorage": {
    "DataDirectory": "Database",
    "SeedWhenEmpty": true
  },
  "Uploads": {
    "Directory": "Uploads",
    "MaxFileSizeBytes": 5242880
  },
  "Jwt": {
    "Issuer": "PetShop.Api",
    "Audience": "PetShop.Web",
    "Secret": "",
    "ExpiryMinutes": 120
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 5,
    "LoginRequestsPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
