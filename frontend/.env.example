# Copy to .env.local to override values on your own machine.
# Everything prefixed with NEXT_PUBLIC_ ends up in the browser bundle, so never put secrets here.

# development | uat | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=One Pet Shop
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/api
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
